{
  "components": {
    "schemas": {
      "Error": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/schemas/Error.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "code": {
            "description": "Stable error code, used as i18n key",
            "examples": [
              "function_type.not_found"
            ],
            "type": "string"
          },
          "detail": {
            "description": "English fallback message",
            "type": "string"
          },
          "fields": {
            "description": "Per-field validation errors",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "params": {
            "additionalProperties": {},
            "description": "Values for the translated message",
            "type": "object"
          },
          "status": {
            "description": "HTTP status code",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "code"
        ],
        "type": "object"
      },
      "FieldError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable error code, used as i18n key",
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "location": {
            "description": "Where the error occurred, e.g. body.key",
            "type": "string"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "type": "object"
      },
      "FunctionType": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/schemas/FunctionType.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "key": {
            "description": "Stable identifier, lower snake case",
            "examples": [
              "dimmer"
            ],
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Display name per locale",
            "type": "object"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "FunctionTypeInput": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/schemas/FunctionTypeInput.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "key": {
            "examples": [
              "dimmer"
            ],
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Display name per locale; \"en\" is required",
            "type": "object"
          }
        },
        "required": [
          "key",
          "name"
        ],
        "type": "object"
      },
      "FunctionTypeList": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/schemas/FunctionTypeList.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/FunctionType"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/api/schemas/Health.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "status": {
            "examples": [
              "ok"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SnapFlow API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/function-types": {
      "get": {
        "operationId": "listFunctionTypes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionTypeList"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List function types",
        "tags": [
          "function-types"
        ]
      },
      "post": {
        "operationId": "createFunctionType",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunctionTypeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionType"
                }
              }
            },
            "description": "Created"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Create a function type",
        "tags": [
          "function-types"
        ]
      }
    },
    "/api/function-types/{id}": {
      "delete": {
        "operationId": "deleteFunctionType",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete a function type",
        "tags": [
          "function-types"
        ]
      },
      "get": {
        "operationId": "getFunctionType",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionType"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get a function type",
        "tags": [
          "function-types"
        ]
      },
      "put": {
        "operationId": "updateFunctionType",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunctionTypeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionType"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Update a function type",
        "tags": [
          "function-types"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness and database check",
        "tags": [
          "system"
        ]
      }
    }
  }
}
