# Copy to .env next to docker-compose.yml. Never commit .env.

# Database password (any long random string: openssl rand -hex 24).
POSTGRES_PASSWORD=

# The first admin, created on the first start (password at least 8 characters).
# Afterwards these are ignored as long as an active admin exists; you may remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Name of the distributor tenant, set on the first start.
DISTRIBUTOR_NAME=Distributor

# Image tag: latest (main), main, a release like 1.2.3, or sha-<short>.
SNAPFLOW_TAG=latest

# Where the app listens. Behind a reverse proxy on the same host: SNAPFLOW_BIND=127.0.0.1.
SNAPFLOW_BIND=0.0.0.0
SNAPFLOW_PORT=8000

# Session cookies are Secure (HTTPS only). Set false only for plain HTTP on a host
# other than localhost, e.g. trying it out on http://192.168.1.10:8000.
COOKIE_SECURE=true

# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12.
TRUSTED_PROXIES=
