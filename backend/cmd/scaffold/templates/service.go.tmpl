// Package [[.Pkg]] manages [[.LowerPlural]].
//
// Scaffolded as catalog data: reads need catalog.read, writes catalog.write
// (see platform/auth). Change the permissions if that does not fit.
package [[.Pkg]]

import (
	"context"
	"errors"
	"time"

	"github.com/google/uuid"
	"github.com/jackc/pgx/v5"

	"github.com/kingkill85/snapflow/backend/internal/features/[[.Pkg]]/store"
	"github.com/kingkill85/snapflow/backend/internal/platform/apperr"
	"github.com/kingkill85/snapflow/backend/internal/platform/auth"
	"github.com/kingkill85/snapflow/backend/internal/platform/i18n"
)

type [[.Type]] struct {
	ID        uuid.UUID `json:"id"`
	Name      i18n.Text `json:"name" doc:"Display name per locale"`
	CreatedAt time.Time `json:"createdAt"`
	UpdatedAt time.Time `json:"updatedAt"`
}

type [[.Type]]Input struct {
	Name i18n.Text `json:"name" doc:"Display name per locale; \"en\" is required"`
}

type Service struct {
	q store.Querier
}

func NewService(q store.Querier) *Service {
	return &Service{q: q}
}

func (s *Service) List(ctx context.Context) ([][[.Type]], error) {
	if _, err := auth.Require(ctx, auth.PermCatalogRead); err != nil {
		return nil, err
	}
	rows, err := s.q.List[[.Plural]](ctx)
	if err != nil {
		return nil, err
	}
	out := make([][[.Type]], len(rows))
	for i, r := range rows {
		out[i] = fromRow(r)
	}
	return out, nil
}

func (s *Service) Get(ctx context.Context, id uuid.UUID) ([[.Type]], error) {
	if _, err := auth.Require(ctx, auth.PermCatalogRead); err != nil {
		return [[.Type]]{}, err
	}
	row, err := s.q.Get[[.Type]](ctx, id)
	if err != nil {
		return [[.Type]]{}, mapErr(err)
	}
	return fromRow(row), nil
}

func (s *Service) Create(ctx context.Context, in [[.Type]]Input) ([[.Type]], error) {
	if _, err := auth.Require(ctx, auth.PermCatalogWrite); err != nil {
		return [[.Type]]{}, err
	}
	if err := validate(in); err != nil {
		return [[.Type]]{}, err
	}
	row, err := s.q.Create[[.Type]](ctx, in.Name)
	if err != nil {
		return [[.Type]]{}, mapErr(err)
	}
	return fromRow(row), nil
}

func (s *Service) Update(ctx context.Context, id uuid.UUID, in [[.Type]]Input) ([[.Type]], error) {
	if _, err := auth.Require(ctx, auth.PermCatalogWrite); err != nil {
		return [[.Type]]{}, err
	}
	if err := validate(in); err != nil {
		return [[.Type]]{}, err
	}
	row, err := s.q.Update[[.Type]](ctx, store.Update[[.Type]]Params{ID: id, Name: in.Name})
	if err != nil {
		return [[.Type]]{}, mapErr(err)
	}
	return fromRow(row), nil
}

func (s *Service) Delete(ctx context.Context, id uuid.UUID) error {
	if _, err := auth.Require(ctx, auth.PermCatalogWrite); err != nil {
		return err
	}
	n, err := s.q.Delete[[.Type]](ctx, id)
	if err != nil {
		return err
	}
	if n == 0 {
		return apperr.NotFound("[[.Singular]].not_found")
	}
	return nil
}

func validate(in [[.Type]]Input) error {
	if !in.Name.Valid() {
		return apperr.Invalid("body.name.en", "validation.required", "English name is required")
	}
	return nil
}

func mapErr(err error) error {
	if errors.Is(err, pgx.ErrNoRows) {
		return apperr.NotFound("[[.Singular]].not_found")
	}
	return err
}

func fromRow(r store.[[.Type]]) [[.Type]] {
	return [[.Type]]{ID: r.ID, Name: r.Name, CreatedAt: r.CreatedAt, UpdatedAt: r.UpdatedAt}
}
