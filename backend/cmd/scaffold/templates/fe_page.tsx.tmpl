import { useQueryClient } from '@tanstack/react-query'
import { Pencil, Plus, Trash2 } from 'lucide-react'
import { useState } from 'react'
import { useTranslation } from 'react-i18next'

import {
  getList[[.Plural]]QueryKey,
  useDelete[[.Type]],
  useList[[.Plural]],
} from '@/api/generated/[[.URL]]/[[.URL]]'
import type { [[.Type]] } from '@/api/generated/model'
import { Button, ConfirmDialog, DataTable, EmptyState, ErrorMessage, Loading, Page } from '@/components/ui'
import { useLocalized } from '@/i18n/localized'

import { [[.Type]]FormDialog } from './[[.Type]]FormDialog'

export function [[.Plural]]Page() {
  const { t } = useTranslation('[[.NS]]')
  const { t: tCommon } = useTranslation()
  const localized = useLocalized()
  const queryClient = useQueryClient()
  const list = useList[[.Plural]]()
  const remove = useDelete[[.Type]]()

  const [formOpen, setFormOpen] = useState(false)
  const [editing, setEditing] = useState<[[.Type]] | null>(null)
  const [deleting, setDeleting] = useState<[[.Type]] | null>(null)

  const openForm = (item: [[.Type]] | null) => {
    setEditing(item)
    setFormOpen(true)
  }

  const confirmDelete = async () => {
    if (!deleting) return
    try {
      await remove.mutateAsync({ id: deleting.id })
    } catch {
      return // shown by ErrorMessage via remove.error
    }
    await queryClient.invalidateQueries({ queryKey: getList[[.Plural]]QueryKey() })
    setDeleting(null)
  }

  const createButton = (
    <Button onClick={() => openForm(null)}>
      <Plus /> {t('new')}
    </Button>
  )

  return (
    <Page title={t('title')} actions={createButton}>
      {list.isPending ? (
        <Loading />
      ) : list.isError ? (
        <ErrorMessage error={list.error} />
      ) : (
        <DataTable
          rows={list.data.items}
          rowKey={(item) => item.id}
          columns={[{ header: t('field.name'), cell: (item) => localized(item.name) }]}
          actions={(item) => (
            <>
              <Button size="sm" variant="secondary" onClick={() => openForm(item)}>
                <Pencil /> {tCommon('action.edit')}
              </Button>
              <Button size="sm" variant="danger" onClick={() => setDeleting(item)}>
                <Trash2 /> {tCommon('action.delete')}
              </Button>
            </>
          )}
          empty={<EmptyState title={t('empty')} action={createButton} />}
        />
      )}

      <[[.Type]]FormDialog open={formOpen} onOpenChange={setFormOpen} item={editing} />

      <ConfirmDialog
        open={deleting !== null}
        onOpenChange={(open) => !open && setDeleting(null)}
        title={t('deleteTitle')}
        message={t('deleteMessage', { name: localized(deleting?.name) })}
        confirmLabel={tCommon('action.delete')}
        pending={remove.isPending}
        onConfirm={() => void confirmDelete()}
        error={<ErrorMessage error={remove.error} />}
      />
    </Page>
  )
}
