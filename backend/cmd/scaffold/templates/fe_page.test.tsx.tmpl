import { screen, waitFor, within } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { http, HttpResponse } from 'msw'
import { describe, expect, it } from 'vitest'

import type { [[.Type]] } from '@/api/generated/model'
import { renderWithProviders } from '@/test/render'
import { server } from '@/test/server'
import { translation } from '@/test/translatable'

import { [[.Plural]]Page } from './[[.Plural]]Page'

const sample: [[.Type]] = {
  id: '6f1c2b8e-0000-4000-8000-000000000001',
  name: { en: 'Sample', de: 'Beispiel' },
  createdAt: '2026-01-01T00:00:00Z',
  updatedAt: '2026-01-01T00:00:00Z',
}

describe('[[.Plural]]Page', () => {
  it('lists items', async () => {
    server.use(http.get('/api/[[.URL]]', () => HttpResponse.json({ items: [sample] })))
    renderWithProviders(<[[.Plural]]Page />)

    expect(await screen.findByText('Sample')).toBeInTheDocument()
  })

  it('creates an item', async () => {
    let items: [[.Type]][] = []
    server.use(
      http.get('/api/[[.URL]]', () => HttpResponse.json({ items })),
      http.post('/api/[[.URL]]', () => {
        items = [sample]
        return HttpResponse.json(sample, { status: 201 })
      }),
    )
    const user = userEvent.setup()
    renderWithProviders(<[[.Plural]]Page />)

    await user.click((await screen.findAllByRole('button', { name: /new/i }))[0])
    const dialog = await screen.findByRole('dialog')
    await user.type(await translation(user, dialog, 'Name', 'en'), 'Sample')
    await user.click(within(dialog).getByRole('button', { name: 'Create' }))

    await waitFor(() => expect(screen.queryByRole('dialog')).not.toBeInTheDocument())
    expect(await screen.findByText('Sample')).toBeInTheDocument()
  })
})
