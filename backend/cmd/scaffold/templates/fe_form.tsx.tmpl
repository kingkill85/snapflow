import { zodResolver } from '@hookform/resolvers/zod'
import { useQueryClient } from '@tanstack/react-query'
import { useEffect } from 'react'
import { useForm } from 'react-hook-form'
import { useTranslation } from 'react-i18next'
import { z } from 'zod'

import {
  getList[[.Plural]]QueryKey,
  useCreate[[.Type]],
  useUpdate[[.Type]],
} from '@/api/generated/[[.URL]]/[[.URL]]'
import type { [[.Type]] } from '@/api/generated/model'
import {
  errorKey,
  ErrorMessage,
  FormDialog,
  FormTranslatableField,
  fromTranslatable,
  setApiFieldErrors,
  toTranslatable,
  translatableApiFields,
  translatableSchema,
} from '@/components/ui'

// Translatable texts are one field with a tab per content locale (D109), never a field per language.
const schema = z.object({
  name: translatableSchema({ required: errorKey('validation.required') }),
})
type FormValues = z.infer<typeof schema>

// API error locations shown at the form's fields: each language of the name on its tab.
const fields = translatableApiFields('name')

type Props = {
  open: boolean
  onOpenChange: (open: boolean) => void
  /** null = create mode, object = edit mode. */
  item: [[.Type]] | null
}

export function [[.Type]]FormDialog({ open, onOpenChange, item }: Props) {
  const { t } = useTranslation('[[.NS]]')
  const { t: tCommon } = useTranslation()
  const queryClient = useQueryClient()
  const create = useCreate[[.Type]]()
  const update = useUpdate[[.Type]]()
  const mutation = item ? update : create

  const form = useForm<FormValues>({ resolver: zodResolver(schema) })
  const { reset } = form
  const { reset: resetCreate } = create
  const { reset: resetUpdate } = update

  // Reset only when the dialog opens or switches record.
  useEffect(() => {
    if (!open) return
    reset({ name: toTranslatable(item?.name) })
    resetCreate()
    resetUpdate()
  }, [open, item, reset, resetCreate, resetUpdate])

  const submit = form.handleSubmit(async (values) => {
    const data = { name: fromTranslatable(values.name) }
    try {
      if (item) await update.mutateAsync({ id: item.id, data })
      else await create.mutateAsync({ data })
    } catch (error) {
      setApiFieldErrors(error, form.setError, fields)
      return // shown by ErrorMessage via mutation.error
    }
    await queryClient.invalidateQueries({ queryKey: getList[[.Plural]]QueryKey() })
    onOpenChange(false)
  })

  return (
    <FormDialog
      open={open}
      onOpenChange={onOpenChange}
      title={item ? t('edit') : t('new')}
      submitLabel={item ? tCommon('action.update') : tCommon('action.create')}
      submitting={mutation.isPending}
      onSubmit={() => void submit()}
      error={<ErrorMessage error={mutation.error} fields={fields} />}
    >
      <FormTranslatableField control={form.control} name="name" label={t('field.name')} required />
    </FormDialog>
  )
}
